<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <j:if test="${it.bannerVisible}">
        <style type="text/css">
            .auditflow-anomaly-banner {
                background: linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(220, 38, 38, 0.18) 100%);
                border: 1px solid rgba(239, 68, 68, 0.35);
                border-left: 5px solid #ef4444;
                color: var(--text-color, #1e293b);
                padding: 10px 18px;
                margin: 12px 20px 14px 20px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                font-family: inherit;
                box-shadow: 0 2px 10px rgba(239, 68, 68, 0.1);
                backdrop-filter: blur(4px);
                z-index: 100;
                position: relative;
                box-sizing: border-box;
            }
            .auditflow-anomaly-banner--critical {
                border-left-color: #dc2626;
                background: linear-gradient(135deg, rgba(220, 38, 38, 0.18) 0%, rgba(185, 28, 28, 0.28) 100%);
            }
            .auditflow-banner-left {
                display: flex;
                align-items: center;
                gap: 12px;
                flex: 1;
                min-width: 0;
            }
            .auditflow-badge {
                background-color: #ef4444;
                color: #ffffff;
                font-size: 0.75rem;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 12px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
            .auditflow-badge--critical {
                background-color: #dc2626;
                animation: auditflow-pulse 2s infinite;
            }
            @keyframes auditflow-pulse {
                0% { opacity: 1; }
                50% { opacity: 0.7; }
                100% { opacity: 1; }
            }
            .auditflow-banner-text {
                font-size: 0.9rem;
                font-weight: 500;
                line-height: 1.4;
            }
            .auditflow-banner-action-btn {
                background: #ef4444;
                color: #ffffff !important;
                padding: 7px 16px;
                border-radius: 6px;
                text-decoration: none !important;
                font-size: 0.85rem;
                font-weight: 600;
                transition: all 0.2s ease;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                flex-shrink: 0;
            }
            .auditflow-banner-action-btn:hover {
                background: #dc2626;
                box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
            }
        </style>
    </j:if>
</j:jelly>

