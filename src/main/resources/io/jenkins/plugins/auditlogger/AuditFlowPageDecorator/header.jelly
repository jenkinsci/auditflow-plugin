<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <j:if test="${it.welcomeBannerVisible}">
        <style type="text/css">
            .auditflow-welcome-banner {
                background: linear-gradient(135deg, rgba(79, 70, 229, 0.12) 0%, rgba(99, 102, 241, 0.22) 100%);
                border: 1px solid rgba(99, 102, 241, 0.4);
                border-left: 5px solid #6366f1;
                color: var(--text-color, #1e293b);
                padding: 12px 18px;
                margin: 8px 16px 12px 16px;
                border-radius: 10px;
                box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
                backdrop-filter: blur(4px);
                z-index: 998;
            }
            .auditflow-welcome-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 8px;
            }
            .auditflow-welcome-title {
                font-size: 1rem;
                font-weight: 700;
                color: #4f46e5;
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .auditflow-welcome-list {
                margin: 6px 0 10px 0;
                padding-left: 20px;
                font-size: 0.88rem;
                line-height: 1.5;
            }
            .auditflow-welcome-list li {
                margin-bottom: 4px;
            }
            .auditflow-welcome-actions {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-top: 8px;
            }
            .auditflow-welcome-btn {
                padding: 5px 14px;
                border-radius: 6px;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                border: none;
                transition: all 0.2s ease;
                text-decoration: none !important;
                white-space: nowrap;
            }
            .auditflow-welcome-btn--primary {
                background: #4f46e5;
                color: #ffffff !important;
            }
            .auditflow-welcome-btn--primary:hover {
                background: #4338ca;
            }
            .auditflow-welcome-btn--dismiss {
                background: rgba(100, 116, 139, 0.15);
                color: var(--text-color, #475569);
            }
            .auditflow-welcome-btn--dismiss:hover {
                background: rgba(100, 116, 139, 0.3);
            }
        </style>
        <div class="auditflow-welcome-banner" id="auditflowWelcomeBanner">
            <div class="auditflow-welcome-header">
                <div class="auditflow-welcome-title">
                    ✨ Welcome to AuditFlow — What's New!
                </div>
            </div>
            <ul class="auditflow-welcome-list">
                <li><strong>🛡️ Phase 2 Security Anomaly Detection:</strong> Real-time automated risk tracking for brute-force logins, unusual IP access, multi-IP logins, suspicious auth patterns, administrative privilege changes, and user lifecycle events.</li>
                <li><strong>🚨 Global Security Alert Banner:</strong> Live page header alert notification system with quick navigation for administrators.</li>
                <li><strong>⚙️ Collapsible Anomaly Control:</strong> Easily toggle master anomaly detection and collapse/expand granular rules in System Settings.</li>
            </ul>
            <div class="auditflow-welcome-actions">
                <j:if test="${it.adminUser}">
                    <a href="${it.auditFlowUrl}" class="auditflow-welcome-btn auditflow-welcome-btn--primary">
                        Explore AuditFlow Dashboard &#8594;
                    </a>
                </j:if>
                <button type="button" class="auditflow-welcome-btn auditflow-welcome-btn--dismiss" onclick="auditflowDismissWelcomeBanner(this)">
                    Dismiss
                </button>
            </div>
        </div>
        <script type="text/javascript">
            function auditflowDismissWelcomeBanner(btn) {
                var banner = document.getElementById('auditflowWelcomeBanner') || (btn ? btn.closest('.auditflow-welcome-banner') : null);
                if (banner) {
                    banner.style.display = 'none';
                }
                var url = (window.rootURL || '') + '/descriptor/io.jenkins.plugins.auditlogger.AuditFlowPageDecorator/dismissWelcomeBanner';
                var headers = {};
                if (window.crumb &amp;&amp; window.crumb.value) {
                    headers[window.crumb.name || 'Jenkins-Crumb'] = window.crumb.value;
                }
                fetch(url, { method: 'POST', headers: headers }).catch(function(e){});
            }
        </script>
    </j:if>

    <j:if test="${it.bannerVisible}">
        <style type="text/css">
            .auditflow-anomaly-banner {
                background: linear-gradient(135deg, rgba(220, 38, 38, 0.12) 0%, rgba(185, 28, 28, 0.22) 100%);
                border: 1px solid rgba(239, 68, 68, 0.4);
                border-left: 5px solid #ef4444;
                color: var(--text-color, #1e293b);
                padding: 10px 16px;
                margin: 8px 16px 12px 16px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-family: inherit;
                box-shadow: 0 2px 8px rgba(239, 68, 68, 0.12);
                backdrop-filter: blur(4px);
                z-index: 999;
            }
            .auditflow-anomaly-banner--critical {
                border-left-color: #dc2626;
                background: linear-gradient(135deg, rgba(220, 38, 38, 0.2) 0%, rgba(153, 27, 27, 0.3) 100%);
            }
            .auditflow-banner-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .auditflow-badge {
                background-color: #ef4444;
                color: #ffffff;
                font-size: 0.75rem;
                font-weight: 700;
                padding: 3px 9px;
                border-radius: 12px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                white-space: nowrap;
            }
            .auditflow-badge--critical {
                background-color: #dc2626;
                animation: auditflow-pulse 2s infinite;
            }
            @keyframes auditflow-pulse {
                0% { opacity: 1; }
                50% { opacity: 0.65; }
                100% { opacity: 1; }
            }
            .auditflow-banner-text {
                font-size: 0.9rem;
                font-weight: 500;
            }
            .auditflow-banner-action-btn {
                background: #ef4444;
                color: #ffffff !important;
                padding: 6px 14px;
                border-radius: 6px;
                text-decoration: none !important;
                font-size: 0.85rem;
                font-weight: 600;
                transition: all 0.2s ease;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }
            .auditflow-banner-action-btn:hover {
                background: #dc2626;
                box-shadow: 0 2px 6px rgba(220, 38, 38, 0.3);
            }
        </style>
        <div class="auditflow-anomaly-banner auditflow-anomaly-banner--${it.highestSeverity.toLowerCase()}">
            <div class="auditflow-banner-left">
                <span class="auditflow-badge auditflow-badge--${it.highestSeverity.toLowerCase()}">
                    &#9888; ${it.highestSeverity} SECURITY ALERT
                </span>
                <span class="auditflow-banner-text">
                    <j:choose>
                        <j:when test="${it.adminUser}">
                            <strong>AuditFlow:</strong> ${it.activeAlertCount} active security anomaly event(s) detected on this Jenkins controller.
                        </j:when>
                        <j:otherwise>
                            <strong>AuditFlow Security Warning:</strong> ${it.activeAlertCount} active security anomaly event(s) detected. Please notify your Jenkins Administrator.
                        </j:otherwise>
                    </j:choose>
                </span>
            </div>
            <j:if test="${it.adminUser}">
                <a href="${it.auditFlowUrl}" class="auditflow-banner-action-btn">
                    Review &amp; Manage in AuditFlow &#8594;
                </a>
            </j:if>
        </div>
    </j:if>
</j:jelly>
