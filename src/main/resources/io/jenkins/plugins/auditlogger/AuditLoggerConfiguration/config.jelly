<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
    <st:adjunct includes="io.jenkins.plugins.auditlogger.AuditLoggerConfiguration.auditflow-timezone-picker"/>

    <f:section title="AuditFlow Configuration">
        <f:block>
            <div class="jenkins-section__description">
                Configure what AuditFlow records, delivery options, and display time zone settings.
            </div>
        </f:block>
    </f:section>

    <f:section title="Event Logging Controls">
        <f:block>
            <div class="jenkins-section__description">
                Core audit logging scope across system activities and user operations.
            </div>
        </f:block>
        <f:entry title="Authentication &amp; Sessions (logins, logouts, failures, and API auth)">
            <f:checkbox name="enableAuthenticationEvents" checked="${descriptor.isEnableAuthenticationEvents()}"/>
        </f:entry>
        <f:entry title="Build Lifecycles (build starts, completions, failures, and deletes)">
            <f:checkbox name="enableBuildEvents" checked="${descriptor.isEnableBuildEvents()}"/>
        </f:entry>
        <f:entry title="Job Configurations (job CRUD and configuration updates)">
            <f:checkbox name="enableJobConfigEvents" checked="${descriptor.isEnableJobConfigEvents()}"/>
        </f:entry>
        <f:entry title="Credentials &amp; Secrets (credential CRUD and build-time usage)">
            <f:checkbox name="enableCredentialEvents" checked="${descriptor.isEnableCredentialEvents()}"/>
        </f:entry>
        <f:entry title="Plugin Management (installs, updates, removals, enables, and disables)">
            <f:checkbox name="enablePluginEvents" checked="${descriptor.isEnablePluginEvents()}"/>
        </f:entry>
        <f:entry title="System &amp; Security (global system and security configuration saves)">
            <f:checkbox name="enableSystemConfigEvents" checked="${descriptor.isEnableSystemConfigEvents()}"/>
        </f:entry>
        <f:entry title="Node &amp; Agent Lifecycles (agent creation, configuration updates, and deletion)">
            <f:checkbox name="enableNodeEvents" checked="${descriptor.isEnableNodeEvents()}"/>
        </f:entry>
    </f:section>

    <f:section title="Security Anomaly Detection">
        <f:block>
            <div class="jenkins-section__description">
                Real-time security anomaly and risk detection rules (Phase 2 expanded).
            </div>
        </f:block>

        <f:optionalBlock title="Failed Login Detection (flag brute force attempts)"
                         name="anomalyFailedLogins"
                         checked="${descriptor.isAnomalyFailedLogins()}">
            <f:entry title="Failed login threshold" description="Trigger alert after this many failed logins for a single account within the time window.">
                <f:number name="anomalyFailedLoginsThreshold" value="${descriptor.getAnomalyFailedLoginsThreshold()}"/>
            </f:entry>
            <f:entry title="Time window (minutes)" description="Sliding window in minutes to evaluate failed logins.">
                <f:number name="anomalyFailedLoginsWindowMinutes" value="${descriptor.getAnomalyFailedLoginsWindowMinutes()}"/>
            </f:entry>
        </f:optionalBlock>

        <f:optionalBlock title="Unusual IP Activity (flag logins or actions from new/unseen IP addresses)"
                         name="anomalyUnusualIp"
                         checked="${descriptor.isAnomalyUnusualIp()}">
            <f:entry title="Tracking window (minutes)" description="Lookback window for user IP address history.">
                <f:number name="anomalyUnusualIpWindowMinutes" value="${descriptor.getAnomalyUnusualIpWindowMinutes()}"/>
            </f:entry>
        </f:optionalBlock>

        <f:optionalBlock title="Multiple Logins from Different IPs (flag concurrent sessions from distinct IP addresses)"
                         name="anomalyMultiIpLogin"
                         checked="${descriptor.isAnomalyMultiIpLogin()}">
            <f:entry title="Distinct IP threshold" description="Trigger alert if a user logs in from this many distinct IP addresses within the window.">
                <f:number name="anomalyMultiIpLoginThreshold" value="${descriptor.getAnomalyMultiIpLoginThreshold()}"/>
            </f:entry>
            <f:entry title="Time window (minutes)" description="Sliding time window to evaluate concurrent multi-IP logins.">
                <f:number name="anomalyMultiIpLoginWindowMinutes" value="${descriptor.getAnomalyMultiIpLoginWindowMinutes()}"/>
            </f:entry>
        </f:optionalBlock>

        <f:entry title="Suspicious Auth Patterns (flag successful login following brute-force attempts)">
            <f:checkbox name="anomalySuspiciousAuth" checked="${descriptor.isAnomalySuspiciousAuth()}"/>
        </f:entry>

        <f:entry title="Admin Privilege Changes (flag security matrix, authorization strategy, or admin permission changes)">
            <f:checkbox name="anomalyAdminPrivilegeChanges" checked="${descriptor.isAnomalyAdminPrivilegeChanges()}"/>
        </f:entry>

        <f:optionalBlock title="User Account Lifecycle (flag user account creation or deletion activity)"
                         name="anomalyUserLifecycle"
                         checked="${descriptor.isAnomalyUserLifecycle()}">
            <f:entry title="Event threshold" description="Trigger alert after this many user creation/deletion events within the window.">
                <f:number name="anomalyUserLifecycleThreshold" value="${descriptor.getAnomalyUserLifecycleThreshold()}"/>
            </f:entry>
            <f:entry title="Time window (minutes)" description="Sliding time window for user lifecycle tracking.">
                <f:number name="anomalyUserLifecycleWindowMinutes" value="${descriptor.getAnomalyUserLifecycleWindowMinutes()}"/>
            </f:entry>
        </f:optionalBlock>
    </f:section>

    <f:section title="Operational Monitoring &amp; Export">
        <f:block>
            <div class="jenkins-section__description">
                Display time zone and export options for reporting and external integrations.
            </div>
        </f:block>
        <f:block>
            <h4>Display Time Zone</h4>
            <div class="jenkins-section__description">
                Choose how AuditFlow displays timestamps in the UI and exports. Stored event timestamps are not modified.
            </div>
        </f:block>
        <f:entry title="Display time zone" field="displayTimeZoneId">
            <div class="auditflow-timezone-picker" id="auditflowTimezonePicker">
                <input type="hidden" name="displayTimeZoneId" id="auditflowDisplayTimeZoneId" value="${descriptor.displayTimeZoneId}"/>
                <div class="auditflow-timezone-picker__combobox">
                    <input type="text"
                           class="jenkins-input auditflow-timezone-picker__input"
                           id="auditflowTimezoneInput"
                           value="${descriptor.displayTimeZoneDisplayName}"
                           placeholder="Search time zone"
                           autocomplete="off"
                           spellcheck="false"
                           role="combobox"
                           aria-autocomplete="list"
                           aria-expanded="false"
                           aria-controls="auditflowTimezoneListbox"/>
                    <button type="button"
                            class="jenkins-button auditflow-timezone-picker__toggle"
                            id="auditflowTimezoneToggle"
                            aria-label="Show time zones">
                        <span class="auditflow-timezone-picker__toggle-caret" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="auditflow-timezone-picker__menu jenkins-hidden" id="auditflowTimezoneMenu">
                    <div class="auditflow-timezone-picker__list"
                         id="auditflowTimezoneListbox"
                         role="listbox"
                         aria-label="Display time zone options"></div>
                    <div class="auditflow-timezone-picker__empty jenkins-hidden" id="auditflowTimezoneEmpty">No matching time zones.</div>
                </div>
                <script type="application/json" id="auditflowTimezoneOptions">${descriptor.availableDisplayTimeZonesJson}</script>
            </div>
        </f:entry>
        <f:block>
            <h4>Notifications</h4>
            <div class="jenkins-section__description">
                Configure notification destinations for audit and alert delivery.
            </div>
        </f:block>
        <f:optionalBlock title="Email notifications (send anomaly alerts through Jenkins mail settings)"
                         name="enableEmailAlerts"
                         checked="${descriptor.isEnableEmailAlerts()}">
            <f:entry title="Alert email addresses"
                     description="Comma-separated recipients for anomaly emails, for example: secops@example.com, admins@example.com">
                <f:textbox name="alertEmailAddresses" value="${descriptor.getAlertEmailAddresses()}"/>
            </f:entry>
        </f:optionalBlock>
        <f:optionalBlock title="Webhook notifications (send anomaly alerts to a webhook endpoint using JSON payload)"
                         name="enableWebhookAlerts"
                         checked="${descriptor.isEnableWebhookAlerts()}">
            <f:entry title="Webhook URL"
                     description="Enter a valid HTTP webhook endpoint such as Slack, Microsoft Teams, or another supported service. AuditFlow sends a JSON payload whenever an alert is created. Example: https://hooks.slack.com/services/T000/B000/XXXX">
                <f:textbox name="webhookUrl" value="${descriptor.getWebhookUrl()}"/>
            </f:entry>
        </f:optionalBlock>
        <f:block>
            <h4>Export and Integrations</h4>
            <div class="jenkins-section__description">
                Download audit log data or integrate with downstream tools.
            </div>
        </f:block>
        <f:entry title="CSV export (enable spreadsheet-based review or downstream reporting)">
            <f:checkbox name="enableCsvExport" checked="${descriptor.isEnableCsvExport()}"/>
        </f:entry>
        <f:entry title="JSON export (enable automation, scripting, or external data processing)">
            <f:checkbox name="enableJsonExport" checked="${descriptor.isEnableJsonExport()}"/>
        </f:entry>
        <f:block>
            <div class="jenkins-section__description">
                AuditFlow REST API endpoint is available by default at <code>/auditflow/api</code>.
            </div>
        </f:block>
    </f:section>

    <f:advanced title="Advanced">
        <f:block>
            <div class="jenkins-section__description">
                Retention, performance, and privacy settings. Existing behavior remains unchanged unless modified.
            </div>
        </f:block>
        <f:block>
            <h4>Log Retention</h4>
        </f:block>
        <f:entry title="Keep logs for (days, 0 = forever)"
                 description="Delete on-disk audit logs older than this many days, or keep them indefinitely by setting the value to 0.">
            <f:number name="logRetentionDays" value="${descriptor.getLogRetentionDays()}"/>
        </f:entry>
        <f:entry title="Max log file size (MB)"
                 description="Rotate to a new audit log file after the current file reaches this size. This helps keep files manageable for backup and support tasks.">
            <f:number name="maxLogFileSizeMB" value="${descriptor.getMaxLogFileSizeMB()}"/>
        </f:entry>
        <f:block>
            <h4>Performance</h4>
        </f:block>
        <f:entry title="Startup grace period (seconds)"
                 description="Suppress startup and reload noise for this many seconds after Jenkins starts. Useful when you want cleaner configuration change logs.">
            <f:number name="startupGracePeriodSeconds" value="${descriptor.getStartupGracePeriodSeconds()}"/>
        </f:entry>
        <f:entry title="Batch write size"
                 description="Flush audit events in batches of this size to balance throughput and disk I/O.">
            <f:number name="batchWriteSize" value="${descriptor.getBatchWriteSize()}"/>
        </f:entry>
        <f:entry title="Batch flush interval (seconds)"
                 description="Flush queued audit events after this many seconds even if the batch size has not been reached.">
            <f:number name="batchFlushIntervalSeconds" value="${descriptor.getBatchFlushIntervalSeconds()}"/>
        </f:entry>
        <f:block>
            <h4>Privacy and Masking</h4>
        </f:block>
        <f:entry title="Mask tokens and secrets (redact API tokens, secret values, and similar credentials)">
            <f:checkbox name="maskTokens" checked="${descriptor.isMaskTokens()}"/>
        </f:entry>
        <f:entry title="Mask credit card numbers (reduce accidental sensitive-data exposure in stored audit messages)">
            <f:checkbox name="maskCreditCards" checked="${descriptor.isMaskCreditCards()}"/>
        </f:entry>
    </f:advanced>
</j:jelly>
